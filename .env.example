# BA STORE - Environment Variables Configuration
# Set these variables in your Vercel Dashboard (Project Settings -> Environment Variables)

# 1. Slip2Go API Secret Key (Keep this secret! Never share or expose on client side)
SLIP2GO_API_KEY=your_slip2go_api_secret_key_here

# 2. Store Administrator PIN (Default: 1234)
ADMIN_PIN=1234

# 3. Store PromptPay Configuration
PROMPTPAY_NUMBER=0982824986
STORE_ACCOUNT_NAME=บจก. บีเอ สโตร์ ดิจิทัล (BA Store)
STORE_BANK_NAME=ธนาคารกสิกรไทย (KBANK)
